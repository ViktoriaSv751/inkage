      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Teendők",
      "short_name": "Teendők",
      "url": "/admin#todo",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Kérdezz",
      "short_name": "Kérdezz",
      "url": "/admin#ask",
      "icons": [
        {
          "src": "/icons/icon-192.png",
